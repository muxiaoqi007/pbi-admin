# 复制为 .env.local 使用；也可以启动后在「设置」页填写。
# 设置页保存的环境写入 data/config.json，优先级高于下面的 Power BI 环境变量。

# 云环境：global = 国际版，china = 世纪互联
PBI_CLOUD=global

# 租户 ID（GUID）或租户域名（如 xxx.onmicrosoft.com / xxx.partner.onmschina.cn）
PBI_TENANT_ID=

# 应用注册的客户端 ID（应用程序 ID）
PBI_CLIENT_ID=

# 应用注册创建的客户端密钥值
PBI_CLIENT_SECRET=

# 管理后台访问密码。
# 生产环境必须设置；开发环境未设置时允许本机无密码调试。
PBI_ADMIN_PASSWORD=

# data/config.json 凭据加密主密钥。
# 生产环境如果要从「设置」页保存 client secret / ROPC 密码，必须设置。
# 请使用独立的高熵随机值，并通过 Docker Secret / Key Vault / 部署平台 Secret 注入。
PBI_CONFIG_ENCRYPTION_KEY=
